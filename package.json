{
  "name": "verboo-desktop",
  "version": "0.6.0-beta.2",
  "description": "Multi-platform desktop app for the Verboo Code CLI (macOS, Windows, Linux)",
  "author": {
    "name": "Gabriel Grasel de Moura",
    "email": "graseeel@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/graseeel/verboo_app.git"
  },
  "homepage": "https://github.com/graseeel/verboo_app#readme",
  "bugs": {
    "url": "https://github.com/graseeel/verboo_app/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "tsc --noEmit && vite build",
    "fetch:tessdata": "node scripts/tauri/fetch-tessdata.mjs",
    "build:chrome-helper": "node scripts/tauri/build-chrome-helper.mjs",
    "build:media-sidecars": "node scripts/tauri/build-media-sidecars.mjs",
    "test:media-sidecars": "node --test scripts/tauri/build-media-sidecars.test.mjs",
    "build:tauri-deps": "node scripts/verify/dedup-cli-package.mjs && node scripts/verify/copy-cli-resource.mjs && npm run fetch:tessdata && npm run build:renderer",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:tauri-deps && npm run build:chrome-helper && cargo +1.89.0 tauri build",
    "tauri:icon": "tauri icon",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lobehub/icons": "^5.10.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@verboo/code": "0.13.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "1.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.2",
    "slot-text": "^0.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "7.3.0",
    "vitest": "^4.1.10"
  }
}
