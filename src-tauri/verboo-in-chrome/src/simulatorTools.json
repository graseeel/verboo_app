{
  "version": "1",
  "tools": [
    {
      "name": "ios_simulator_list",
      "description": "List available iOS Simulator devices and the currently attached device.",
      "risk": "read",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "ios_simulator_attach",
      "description": "Attach one iOS Simulator device to the Verboo desktop session.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "streamFps": { "type": "integer", "enum": [30, 60] },
          "fallbackFps": { "type": "number", "enum": [0.5, 1, 2] }
        },
        "required": ["udid"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_screenshot",
      "description": "Capture the latest frame from the attached iOS Simulator.",
      "risk": "read",
      "inputSchema": {
        "type": "object",
        "properties": { "udid": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_tap",
      "description": "Tap a normalized point in the attached iOS Simulator.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["x", "y"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_drag",
      "description": "Drag between two normalized points in the attached iOS Simulator.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "fromX": { "type": "number", "minimum": 0, "maximum": 1 },
          "fromY": { "type": "number", "minimum": 0, "maximum": 1 },
          "toX": { "type": "number", "minimum": 0, "maximum": 1 },
          "toY": { "type": "number", "minimum": 0, "maximum": 1 },
          "durationMs": { "type": "integer", "minimum": 50, "maximum": 5000 }
        },
        "required": ["fromX", "fromY", "toX", "toY"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_type_text",
      "description": "Type text into the focused control in the attached iOS Simulator.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "text": { "type": "string", "maxLength": 4000 }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_press_key",
      "description": "Press a supported key in the attached iOS Simulator.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "key": {
            "type": "string",
            "enum": ["enter", "backspace", "tab", "arrowUp", "arrowDown", "arrowLeft", "arrowRight"]
          }
        },
        "required": ["key"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_system_action",
      "description": "Perform a generic iOS system action on the attached Simulator.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "action": {
            "type": "string",
            "enum": ["home", "appSwitcher", "notifications", "controlCenter", "rotateClockwise"]
          }
        },
        "required": ["action"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_list_apps",
      "description": "List installed applications on the attached iOS Simulator, including their display names and bundle identifiers.",
      "risk": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_launch_app",
      "description": "Launch any installed application on the attached iOS Simulator by bundle identifier.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": {
          "udid": { "type": "string", "minLength": 1, "maxLength": 256 },
          "bundleId": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "required": ["bundleId"],
        "additionalProperties": false
      }
    },
    {
      "name": "ios_simulator_detach",
      "description": "Detach Verboo from the current iOS Simulator without shutting the device down.",
      "risk": "mutate",
      "inputSchema": {
        "type": "object",
        "properties": { "udid": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "additionalProperties": false
      }
    }
  ]
}
